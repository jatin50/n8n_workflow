# Server
PORT=4000
NODE_ENV=development

# Database (matches docker-compose service below)
DATABASE_URL="postgresql://n8n_clone:n8n_clone@localhost:5432/n8n_clone?schema=public"

# Redis (used from Phase 6 onward, wired here early so env stays stable)
REDIS_URL="redis://localhost:6379"

# Auth (used from Phase 2 onward)
JWT_SECRET="change-me-in-real-env"
JWT_REFRESH_SECRET="change-me-too-must-differ-from-jwt-secret"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Frontend origin allowed to call this API
CORS_ORIGIN="http://localhost:5173"
