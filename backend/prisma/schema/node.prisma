model Node {
  id            String @id @default(cuid())
  workflowId    String
  type          String // e.g. "trigger.webhook", "logic.if", "http.request"
  positionX     Float
  positionY     Float
  configuration Json   @default("{}")

  workflow            Workflow        @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  outgoingConnections Connection[]    @relation("SourceNode")
  incomingConnections Connection[]    @relation("TargetNode")
  executionData       ExecutionData[]

  @@index([workflowId])
  @@map("nodes")
}

model Connection {
  id           String  @id @default(cuid())
  workflowId   String
  sourceNode   String
  targetNode   String
  sourceHandle String?
  targetHandle String?

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  source   Node     @relation("SourceNode", fields: [sourceNode], references: [id], onDelete: Cascade)
  target   Node     @relation("TargetNode", fields: [targetNode], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@index([sourceNode])
  @@index([targetNode])
  @@map("connections")
}
