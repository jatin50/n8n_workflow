model Credential {
  id            String   @id @default(cuid())
  workspaceId   String
  name          String // e.g. "My OpenAI Key" — how it shows up in the picker
  type          String // e.g. "openai", "postgres", "slack"
  encryptedData String // AES-encrypted secret, decrypted only at execution time
  createdAt     DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("credentials")
}

model Variable {
  id          String @id @default(cuid())
  workspaceId String
  key         String
  value       String

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
  @@map("variables")
}
