model Credential {
  id            String @id @default(cuid())
  workspaceId   String
  type          String // e.g. "openai", "postgres", "slack"
  encryptedData String // AES-encrypted JSON blob, decrypted only at execution time

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("credentials")
}

model Variable {
  id          String @id @default(cuid())
  workspaceId String
  key         String
  value       String

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
  @@map("variables")
}
