model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String // bcrypt hash, never the plaintext value
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownedWorkspaces Workspace[] @relation("WorkspaceOwner")
  auditLogs       AuditLog[]

  @@map("users")
}
